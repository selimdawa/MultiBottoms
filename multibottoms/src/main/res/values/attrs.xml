<?xml version="1.0" encoding="utf-8"?>
<resources>

    <declare-styleable name="BubbleBottomNavigation">
        <attr name="mbn_defaultIconColor" format="color" />
        <attr name="mbn_selectedIconColor" format="color" />
        <attr name="mbn_backgroundBottomColor" format="color" />
        <attr name="mbn_circleColor" format="color" />
        <attr name="mbn_countTextColor" format="color" />
        <attr name="mbn_countBackgroundColor" format="color" />
        <attr name="mbn_countTypeface" format="string" />
        <attr name="mbn_rippleColor" format="color" />
        <attr name="mbn_shadowColor" format="color" />
        <attr name="mbn_hasAnimation" format="boolean" />
        <attr name="mbn_isHapticFeedbackEnabled" format="boolean" />

        <attr name="mbn_curveType" format="enum">
            <enum name="round" value="0" />
            <enum name="sharp" value="1" />
            <enum name="square" value="2" />

        </attr>
        <attr name="mbn_animationMode" format="enum">
            <enum name="slide" value="0" />
            <enum name="morph" value="1" />
            <enum name="bounce" value="2" />
            <enum name="drop" value="3" />
            <enum name="jump" value="4" />
            <enum name="flip" value="5" />
            <enum name="zoom" value="6" />
            <enum name="rotate" value="7" />
            <enum name="shake" value="8" />
            <enum name="anticipate" value="9" />
            <enum name="elastic" value="10" />
            <enum name="fade" value="11" />
            <enum name="squash" value="12" />
            <enum name="wave" value="13" />
            <enum name="pulse" value="14" />
            <enum name="fling" value="15" />
            <enum name="spin_move" value="16" />
            <enum name="glow" value="17" />
            <enum name="jelly" value="18" />
            <enum name="tilt" value="19" />
        </attr>

        <attr name="mbn_animationDuration" format="integer" />
        <attr name="mbn_backToHomeEnabled" format="boolean" />
        <attr name="mbn_homeId" format="integer" />
        <attr name="mbn_defaultSelectedId" format="integer" />
        <!-- Custom Shape Attributes -->
        <attr name="mbn_bezierWidth" format="dimension" />
        <attr name="mbn_bezierHeight" format="dimension" />
    </declare-styleable>

    <declare-styleable name="ReadableBottomBar">
        <attr name="rbb_tabs" format="reference" />
        <attr name="rbb_backgroundColor" format="color" />
        <attr name="rbb_indicatorColor" format="color" />
        <attr name="rbb_indicatorHeight" format="dimension" />
        <attr name="rbb_initialIndex" format="integer" />
        <attr name="rbb_textColor" format="color" />
        <attr name="rbb_iconColor" format="color" />
        <attr name="rbb_textSize" format="dimension" />
        <attr name="rbb_activeItemType" format="enum">
            <enum name="text" value="0" />
            <enum name="icon" value="1" />
        </attr>
    </declare-styleable>

    <declare-styleable name="BubbleToggleView">
        <attr name="bt_icon" format="reference" />
        <attr name="bt_iconWidth" format="dimension" />
        <attr name="bt_iconHeight" format="dimension" />
        <attr name="bt_shape" format="reference" />
        <attr name="bt_shapeColor" format="color" />
        <attr name="bt_showShapeAlways" format="boolean" />
        <attr name="bt_title" format="string" />
        <attr name="bt_titleSize" format="dimension" />
        <attr name="bt_colorActive" format="color" />
        <attr name="bt_colorInactive" format="color" />
        <attr name="bt_active" format="boolean" />
        <attr name="bt_duration" format="integer" />
        <attr name="bt_padding" format="dimension" />
        <attr name="bt_titlePadding" format="dimension" />
        <attr name="bt_badgeTextSize" format="dimension" />
        <attr name="bt_badgeBackgroundColor" format="color" />
        <attr name="bt_badgeTextColor" format="color" />
        <attr name="bt_badgeText" format="string" />
    </declare-styleable>
    <declare-styleable name="BubbleNavigationConstraintView">
        <attr name="bnc_mode">
            <enum name="spread" value="0" />
            <enum name="inside" value="1" />
            <enum name="packed" value="2" />
        </attr>
    </declare-styleable>

    <declare-styleable name="SmoothBottomBar">
        <attr name="menu" format="reference" />
        <attr name="backgroundColor" format="color" />
        <attr name="indicatorColor" format="color" />
        <attr name="indicatorRadius" format="dimension" />
        <attr name="sideMargins" format="dimension" />
        <attr name="itemPadding" format="dimension" />
        <attr name="itemSpacing" format="dimension" />
        <attr name="textColor" format="color" />
        <attr name="badgeColor" format="color" />
        <!-- New: icon background color and padding -->
        <attr name="iconBackgroundColor" format="color" />
        <attr name="iconBackgroundPadding" format="dimension" />
        <!-- End new -->
        <attr name="itemFontFamily" format="reference" />
        <attr name="textSize" format="dimension" />
        <attr name="iconSize" format="dimension" />
        <attr name="iconMargin" format="dimension" />
        <attr name="iconTint" format="color"/>
        <attr name="iconTintActive" format="color"/>
        <attr name="cornerRadius" format="dimension" />
        <attr name="activeItem" format="integer" />
        <attr name="duration" format="integer" />
        <attr name="corners">
            <flag name="none" value="0" />
            <flag name="top_left" value="1" />
            <flag name="top_right" value="2" />
            <flag name="bottom_right" value="4" />
            <flag name="bottom_left" value="8" />
            <flag name="all" value="15" />
        </attr>
    </declare-styleable>
    <attr name="SmoothBottomBarStyle" format="reference" />

</resources>